# Copy this file to .env and replace every placeholder with your own value.
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# NextAuth: use the site origin, without a trailing slash.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Cloudflare Workers AI image generation. Get both values from Workers AI > Use REST API.
CLOUDFLARE_ACCOUNT_ID="replace-with-your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="replace-with-your-workers-ai-api-token"

# Cloudinary image uploads. The cloud name must use this exact variable name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="replace-with-your-cloud-name"
CLOUDINARY_API_KEY="replace-with-your-cloudinary-api-key"
CLOUDINARY_API_SECRET="replace-with-your-cloudinary-api-secret"

# Choose this code yourself; users must enter it on the registration form.
ACCESS_CODE="replace-with-your-private-registration-code"

CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN